.DS_Store
.claude/
__pycache__/
*.pyc

# source documents are downloaded by each reader (see references/README.md), not redistributed
references/*
!references/README.md

# people's notes are never pushed; only the folder's README and marker file are kept in the repository
notes/*
!notes/README.md
!notes/folder.js

# downloads made by build/tools/check_evidence.py
.evidence-cache/
build/tools/pdf2txt
